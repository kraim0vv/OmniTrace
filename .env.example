# =============================================================
# OmniTrace OSINT Platform — Configuration
# =============================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Scanner Engine Tuning
OMNITRACE_TIMEOUT=8.0
OMNITRACE_MAX_CONCURRENCY=20
# Maximum scans running at the same time (extra requests get HTTP 429)
OMNITRACE_MAX_ACTIVE_SCANS=5

# Network OPSEC & Proxy (HTTP, HTTPS, SOCKS5, or Tor)
# Examples:
# OMNITRACE_PROXY=socks5://127.0.0.1:9050
# OMNITRACE_PROXY=http://proxyuser:proxypass@1.2.3.4:8080
OMNITRACE_PROXY=

# Optional API Keys (Zero keys required for default operation!)
HIBP_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
HUNTER_API_KEY=

# Public deployment (website on a VPS / cloud)
# Set a password to protect the whole site with HTTP Basic Auth.
# STRONGLY recommended whenever the server is reachable from the internet.
OMNITRACE_USER=admin
OMNITRACE_PASSWORD=
# Comma-separated extra origins allowed via CORS (not needed when UI and API share a host)
OMNITRACE_CORS_ORIGINS=
